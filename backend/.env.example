FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=placement_portal
DB_PORT=3306
# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash

# Groq AI Configuration (Llama 3.3) - Free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# AI Calling Assistant (external service)
# This backend can now host the AI calling server endpoints itself (ASGI).
# If you want to use an external AI calling service, set AI_CALLING_SERVICE_URL.
AI_CALLING_ENABLED=false
AI_CALLING_SERVICE_URL=
AI_CALLING_ENDPOINT=/call
AI_CALLING_SERVICE_TOKEN=
AI_CALLING_TIMEOUT=20
AI_CALLING_REQUIRE_VERIFIED=true

# Twilio (required when AI calling is enabled)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Public URL that Twilio can reach (your Railway domain)
CALLING_PUBLIC_URL=

# Optional
TWILIO_WEBHOOK_PATH=/answer
AI_CALLING_STT_LANGUAGE=en
AI_CALLING_TTS_VOICE=en-IN-NeerjaNeural
AI_CALLING_TTS_RATE=+8%

# Remote STT (recommended for Railway image size limits)
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_CALLING_STT_MODEL=whisper-1

# If users enter 10-digit numbers, prefix this (e.g. +91)
AI_CALLING_DEFAULT_COUNTRY_CODE=

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT=service-account.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com